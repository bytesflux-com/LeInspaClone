# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions region (must match functions/src/index.js)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Google Places Autocomplete (Maps JavaScript API + Places API enabled)
VITE_GOOGLE_MAPS_API_KEY=

# Set to "true" to point the app at the local Firebase emulators
VITE_USE_EMULATORS=false

# ADM-025 → ADM-028 in-memory demo backend (true = demo data, unset/false = live Cloud Functions)
VITE_USE_MOCK_PROVIDERS=false
